# =====================================================================
#  Особисті налаштування (шаблон)
# ---------------------------------------------------------------------
#  Скрипт запуску (Windows/start.bat або Mac/start.command) САМ створює
#  з цього шаблону файл .env і заповнює його. Вручну нічого робити не треба.
#
#  Файл .env містить ваші паролі — нікому його не надсилайте
#  і не викладайте в інтернет.
# =====================================================================

# --- ngrok: публічна адреса для вебхуків n8n -------------------------
# Токен: https://dashboard.ngrok.com/get-started/your-authtoken
# Домен: https://dashboard.ngrok.com/domains (наприклад: abc-def.ngrok-free.app)
# Якщо залишити порожніми — усе працюватиме, але без публічної адреси.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- Паролі та ключі --------------------------------------------------
# Генеруються автоматично під час першого запуску.
# НЕ змінюйте їх після першого запуску — інакше програми не зможуть
# відкрити вже збережені дані.
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
TWENTY_APP_SECRET=
TWENTY_ENCRYPTION_KEY=

# --- Заповнюється скриптом запуску автоматично ------------------------
# Адреса, яку n8n показує для вебхуків (https://<ваш домен ngrok>/).
N8N_WEBHOOK_URL=http://localhost:5678/
# "tunnel" — запускати ngrok; порожньо — не запускати.
COMPOSE_PROFILES=
